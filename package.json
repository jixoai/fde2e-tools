{
  "name": "fde2e-tools",
  "private": true,
  "version": "0.1.0",
  "description": "FDE2E 工具集（tool.fde2e.com 工具黄页 + 各工具独立站）——全静态、零后端的公共工具仓库",
  "type": "module",
  "packageManager": "pnpm@12.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm -r run check",
    "build": "pnpm -r run build",
    "webmcp:check": "node scripts/webmcp-check.mjs",
    "prep:audio-smoke-weights": "node deploy/models-fetch.mjs --model whisper-base-q8 && node deploy/models-fetch.mjs --model kokoro-v1_1-zh-int8",
    "audio-smoke": "node scripts/audio-smoke.mjs",
    "vision:walk": "node scripts/vision-walk.mjs",
    "smoke:check": "node scripts/smoke-check.mjs",
    "dev:directory": "pnpm --filter directory dev",
    "dev:pdf-tool": "pnpm --filter pdf-tool dev",
    "dev:img-tool": "pnpm --filter img-tool dev",
    "dev:url-tool": "pnpm --filter url-tool dev",
    "dev:file-viewer": "pnpm --filter file-viewer dev",
    "test:file-viewer": "pnpm --filter file-viewer test",
    "dev:easy-xlsx": "pnpm --filter easy-xlsx dev",
    "dev:easy-docx": "pnpm --filter easy-docx dev",
    "dev:easy-pptx": "pnpm --filter easy-pptx dev",
    "dev:xlsx-editor": "pnpm --filter xlsx dev",
    "dev:docx-editor": "pnpm --filter docx dev",
    "dev:pptx-editor": "pnpm --filter pptx dev",
    "dev:audio-stt": "pnpm --filter audio-stt dev",
    "dev:audio-tts": "pnpm --filter audio-tts dev"
  },
  "devDependencies": {
    "playwright-core": "^1.55.0",
    "adm-zip": "^0.5.16",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "mammoth": "^1.13.0"
  },
  "license": "Apache-2.0"
}
