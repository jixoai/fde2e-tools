{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "vite/client"
    ],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/pptist/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/pptist/views",
    "src/pptist/components"
  ]
}
